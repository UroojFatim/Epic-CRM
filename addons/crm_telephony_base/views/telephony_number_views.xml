<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_telephony_number_tree" model="ir.ui.view">
    <field name="name">telephony.number.tree</field>
    <field name="model">telephony.number</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="phone_e164"/>
        <field name="account_id"/>
        <field name="can_sms"/>
        <field name="can_voice"/>
        <field name="route_to_agent"/>
      </tree>
    </field>
  </record>

  <record id="view_telephony_number_form" model="ir.ui.view">
    <field name="name">telephony.number.form</field>
    <field name="model">telephony.number</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="account_id"/>
            <field name="phone_e164"/>
            <field name="can_sms"/>
            <field name="can_voice"/>
            <field name="route_to_agent"/>
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_telephony_numbers" model="ir.actions.act_window">
    <field name="name">Numbers</field>
    <field name="res_model">telephony.number</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_telephony_numbers" name="Numbers" parent="menu_telephony_root" action="action_telephony_numbers"/>
</odoo>
