<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="crm_lead_form_telephony_buttons" model="ir.ui.view">
    <field name="name">crm.lead.form.telephony.buttons</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_send_sms" type="object" class="oe_highlight" string="Send SMS"
                attrs="{'invisible': ['|', ('phone','=',False), ('mobile','=',False)]}"/>
        <button name="action_call_lead" type="object" string="Call"
                attrs="{'invisible': ['|', ('phone','=',False), ('mobile','=',False)]}"/>
        <field name="use_bot_for_this_lead"/>
        <field name="last_sms_status" readonly="1"/>
        <field name="last_call_status" readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
