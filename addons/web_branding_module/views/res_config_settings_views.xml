<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_web_theme" model="ir.ui.view">
        <field name="name">res.config.settings.view.web.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Brand / Theme" name="web_theme_settings">
                    <field name="web_theme_primary" placeholder="#RRGGBB"/>
                    <field name="web_theme_secondary" placeholder="#RRGGBB"/>
                    <field name="web_theme_accent" placeholder="#RRGGBB"/>
                    <field name="web_theme_header_bg" placeholder="#RRGGBB"/>
                    <field name="web_theme_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
