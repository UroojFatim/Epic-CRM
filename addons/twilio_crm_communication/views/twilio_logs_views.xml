<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_twilio_sms_log_tree" model="ir.ui.view">
        <field name="name">twilio.sms.log.tree</field>
        <field name="model">twilio.sms.log</field>
        <field name="arch" type="xml">
            <tree string="Twilio SMS Logs">
                <field name="lead_id"/>
                <field name="to_number"/>
                <field name="twilio_sid"/>
                <field name="status"/>
                <field name="sent_at"/>
            </tree>
        </field>
    </record>

    <record id="view_twilio_sms_log_form" model="ir.ui.view">
        <field name="name">twilio.sms.log.form</field>
        <field name="model">twilio.sms.log</field>
        <field name="arch" type="xml">
            <form string="Twilio SMS Log">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="lead_id"/>
                        <field name="partner_id"/>
                        <field name="to_number"/>
                        <field name="from_number"/>
                        <field name="twilio_sid"/>
                        <field name="status"/>
                        <field name="sent_by"/>
                        <field name="sent_at"/>
                    </group>
                    <group>
                        <field name="body"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_twilio_sms_log" model="ir.actions.act_window">
        <field name="name">SMS Logs</field>
        <field name="res_model">twilio.sms.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_twilio_call_log_tree" model="ir.ui.view">
        <field name="name">twilio.call.log.tree</field>
        <field name="model">twilio.call.log</field>
        <field name="arch" type="xml">
            <tree string="Twilio Call Logs">
                <field name="lead_id"/>
                <field name="to_number"/>
                <field name="twilio_sid"/>
                <field name="status"/>
                <field name="created_at"/>
            </tree>
        </field>
    </record>

    <record id="view_twilio_call_log_form" model="ir.ui.view">
        <field name="name">twilio.call.log.form</field>
        <field name="model">twilio.call.log</field>
        <field name="arch" type="xml">
            <form string="Twilio Call Log">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="lead_id"/>
                        <field name="to_number"/>
                        <field name="from_number"/>
                        <field name="twilio_sid"/>
                        <field name="status"/>
                        <field name="direction"/>
                        <field name="duration"/>
                        <field name="created_by"/>
                        <field name="created_at"/>
                    </group>
                    <group>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_twilio_call_log" model="ir.actions.act_window">
        <field name="name">Call Logs</field>
        <field name="res_model">twilio.call.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_twilio_root"
        name="Twilio"
        parent="crm.crm_menu_config"
        sequence="90"
        groups="twilio_crm_communication.group_twilio_admin"/>

    <menuitem
        id="menu_twilio_sms_log"
        name="SMS Logs"
        parent="menu_twilio_root"
        action="action_twilio_sms_log"
        sequence="1"
        groups="twilio_crm_communication.group_twilio_admin"/>

    <menuitem
        id="menu_twilio_call_log"
        name="Call Logs"
        parent="menu_twilio_root"
        action="action_twilio_call_log"
        sequence="2"
        groups="twilio_crm_communication.group_twilio_admin"/>
</odoo>
