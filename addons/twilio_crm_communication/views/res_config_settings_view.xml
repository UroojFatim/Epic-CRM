<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_twilio_crm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.twilio.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="Twilio (CRM Calls &amp; SMS)" groups="twilio_crm_communication.group_twilio_admin">
                    <setting string="Twilio Account SID" help="Twilio Account SID used to authenticate API calls.">
                        <field name="twilio_account_sid"/>
                    </setting>
                    <setting string="Twilio Auth Token" help="Twilio Auth Token paired with the Account SID.">
                        <field name="twilio_auth_token" password="True"/>
                    </setting>
                    <setting string="Twilio From Number" help="Default Twilio phone number in E.164 format (e.g. +14155552671).">
                        <field name="twilio_from_number"/>
                    </setting>
                    <setting string="Twilio Webhook Base URL" help="Public HTTPS base URL used by Twilio to call webhook endpoints.">
                        <field name="twilio_webhook_base_url"/>
                    </setting>
                    <setting string="Twilio TwiML App SID" help="Optional TwiML App SID for call routing and behavior.">
                        <field name="twilio_twiml_app_sid"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
