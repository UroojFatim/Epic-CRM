<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_twilio_sms_wizard_form" model="ir.ui.view">
        <field name="name">twilio.sms.wizard.form</field>
        <field name="model">twilio.sms.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SMS">
                <sheet>
                    <group>
                        <field name="lead_id" invisible="1"/>
                        <field name="to_number"/>
                        <field name="body"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_sms" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_twilio_sms_wizard" model="ir.actions.act_window">
        <field name="name">Send SMS</field>
        <field name="res_model">twilio.sms.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_twilio_sms_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
