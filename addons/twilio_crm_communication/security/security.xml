<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_twilio_crm" model="ir.module.category">
            <field name="name">CRM</field>
            <field name="parent_id" ref="base.module_category_sales"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_twilio_user" model="res.groups">
            <field name="name">Twilio User</field>
            <field name="category_id" ref="twilio_crm_communication.module_category_twilio_crm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_twilio_admin" model="res.groups">
            <field name="name">Twilio Admin</field>
            <field name="category_id" ref="twilio_crm_communication.module_category_twilio_crm"/>
            <field name="implied_ids" eval="[(4, ref('twilio_crm_communication.group_twilio_user')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
